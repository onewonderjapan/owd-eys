# Copy to .env (gitignored) and fill in with your own account values.
# Nothing in this file may be committed with real identifiers.
#
#   Git Bash / Linux / macOS:  set -a; . ./.env; set +a
#   PowerShell:                Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim()) } }

# ---------------------------------------------------------------- deployment
# AWS CLI profile used for deploy/publish. There is deliberately no default:
# scripts/publish.py refuses to run without an explicit profile so that an
# ambient or administrator profile is never picked up by accident.
EYS_AWS_PROFILE=

# 12-digit AWS account id the publish target must belong to (sts:GetCallerIdentity guard).
EYS_AWS_ACCOUNT_ID=

# Public host name of the site.
EYS_SITE_DOMAIN=example.invalid

# Private S3 bucket holding the published build under out/.
EYS_S3_BUCKET=

# Bucket region (used to build the private-origin URL checked by verify-remote).
EYS_S3_REGION=ap-northeast-1

# CloudFront distribution id receiving the invalidation after upload.
EYS_CF_DISTRIBUTION_ID=

# ACM certificate ARN (us-east-1) and Route 53 hosted zone id for the CloudFormation stack.
EYS_ACM_CERT_ARN=
EYS_HOSTED_ZONE_ID=

# Optional: CloudFront policy ids, when reusing shared custom policies instead of
# the AWS managed defaults baked into infra/site.example.yaml.
EYS_CF_CACHE_POLICY_ID=
EYS_CF_RESPONSE_HEADERS_POLICY_ID=

# ------------------------------------------------- asset pipeline (optional)
# Remote Blender build host: SSH target, host name for the SMB share, and the
# remote account whose home holds the outbox. Only needed by scripts/immersion/.
EYS_S1_SSH_TARGET=s1
EYS_S1_HOST=
EYS_S1_USER=
# Full overrides, if the derived defaults do not match your layout.
EYS_IMMERSION_ARCHIVE=
EYS_IMMERSION_SHARE=
EYS_IMMERSION_HOME=
EYS_IMMERSION_RUNTIME=

# ------------------------------------------------------------ browser tests
# Browser binary for the Playwright smoke scripts. Set to an empty value to use
# the Chromium that Playwright downloads (what CI does).
CHROME_PATH=
